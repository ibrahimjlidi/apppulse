# Replace these values before using the application.
MYSQL_DATABASE=apppulse
MYSQL_USER=apppulse
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# MySQL is bound to the local machine only, not publicly exposed.
MYSQL_HOST_PORT=3307

# Used when running the API directly on the host.
DB_HOST=localhost
DB_PORT=3307

HTTP_PORT=8080
PMA_ABSOLUTE_URI=http://localhost:8080/phpmyadmin/
